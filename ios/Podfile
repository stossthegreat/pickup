# Mirrorly iOS Podfile — pinned to iOS 15.5 for ML Kit compatibility
platform :ios, '15.5'

# SELF-HEAL the SwiftPM binary-artifact state on CI.
#
# THIS PROJECT DOES NOT USE SWIFT PACKAGE MANAGER. There are zero SPM
# references in Runner.xcodeproj and every dependency is a pod. SPM only
# appears because Flutter injects it at build time when the machine has
# `enable-swift-package-manager` switched on, and it then drags in the
# whole firebase-ios-sdk package graph — including a gRPC BINARY
# artifact that CocoaPods never needed, because gRPC belongs to
# Firestore and this app only uses Analytics.
#
# The real fix is one line in the CI pre-build step:
#
#     flutter config --no-enable-swift-package-manager
#
# Everything below is the fallback for when it's left on. Two different
# directories can hold a broken artifact and they fail differently:
#
#   ~/Library/Caches/org.swift.swiftpm/artifacts
#       The shared cache. An interrupted build leaves half-written zips
#       here and the next build fails resolution with "... already
#       exists in file system".
#
#   <project>/build/ios/SourcePackages/artifacts
#       The per-build checkout. When the shared cache is emptied — by
#       the purge above, or by a failed download — but this directory
#       still holds a manifest pointing into it, resolution fails the
#       OTHER way: "file not found at path: .../grpc-binary/grpc/
#       grpc.zip". Only the first directory was being cleared, so this
#       failure survived the self-heal that was written for it.
#
# Both go. pod install runs before xcodebuild resolves packages, so this
# is the last safe moment to do it. CI-only (Codemagic sets CM_BUILD_ID)
# so local dev machines keep their cache and their ~1-minute re-download.
if ENV['CI'] || ENV['CM_BUILD_ID']
  require 'fileutils'
  FileUtils.rm_rf(File.expand_path('~/Library/Caches/org.swift.swiftpm/artifacts'))
  # TWO dot-dots, not one. File.expand_path treats __FILE__ as the base
  # DIRECTORY, so the first `..` only cancels the `Podfile` filename and
  # lands back in ios/ — that's why the existing Generated.xcconfig
  # lookup above uses a single one. Getting to the repo root, where
  # build/ios/SourcePackages actually lives, takes a second.
  FileUtils.rm_rf(File.expand_path(
    File.join('..', '..', 'build', 'ios', 'SourcePackages'), __FILE__))
end

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Force iOS 15.5 minimum across all pods — required by ML Kit
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # Camera + photo library + microphone usage — keeps pods happy when
      # macro-enabled. MICROPHONE added with the Auralay graft (Eyes voice
      # drills + Game tab voice surfaces use `record`, `audioplayers`,
      # `flutter_pcm_sound`). Set defensively so any transitive
      # `permission_handler` compile path includes the mic-prompt code
      # instead of stripping it. Matches Auralay's known-good archive
      # config so the App Store build behaves identically.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
      ]

      # Avoid bitcode — Apple deprecated it in 2022; some pods still ship
      # with it enabled and break archive builds. Matches Auralay's
      # known-good archive setting.
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Exclude arm64 for simulator to avoid M-chip simulator build issues
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end
end
